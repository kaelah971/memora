NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Explicitly enables server-side service-role reads for the local P1 shell only.
MEMORA_DEV_DB_ACCESS=service_role

# Existing P0.5 Minds variables remain server-side only.
MINDS_BUILDER_API_KEY=
MEMORA_MIND_ID=
MEMORA_MIND_ALIAS=memora-main

# P1.5 YouTube OAuth values. Keep all three server-side only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/youtube/callback

# 32-byte base64 or 64-character hex key used to encrypt OAuth tokens at rest.
YOUTUBE_TOKEN_ENCRYPTION_KEY=
